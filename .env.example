# ==============================================================================
# Homelab Global Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# DO NOT commit your active .env file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# System & User Settings
# ------------------------------------------------------------------------------
# Set timezone (e.g., America/New_York, Europe/London, Asia/Dhaka)
TZ=Asia/Dhaka

# User ID and Group ID (run `id $USER` to find yours - usually 1000)
PUID=1000
PGID=1000

# Base directory for all container data, configs, and media mounts
DOCKER_ROOT=/home/tokit/docker
DATA_ROOT=/home/tokit/docker

# Local Host / Server IP on your LAN
SERVER_IP=192.168.0.225

# ------------------------------------------------------------------------------
# Networking & Remote Access Tokens
# ------------------------------------------------------------------------------
# Tailscale pre-authentication key (generate in Tailscale admin console)
TAILSCALE_AUTHKEY=tskey-auth-your-tailscale-key-here

# Cloudflare Zero Trust Tunnel Token
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...your_cloudflare_tunnel_token_here...

# Pi-hole Web Admin Password (leave blank for no password, or set strong secret)
PIHOLE_PASSWORD=your_secure_pihole_password_here

# ------------------------------------------------------------------------------
# Media & Download Automation
# ------------------------------------------------------------------------------
# Path to store downloaded media and torrent data
DOWNLOADS_DIR=/home/tokit/Downloads
MEDIA_DIR=/home/tokit/docker/jellyfin

# Network Speaker Audio Stack
AUDIO_PUID=568
AUDIO_PGID=568
AUDIO_GID=29
SPEAKER_NAME=TrueNAS-Speakers
ALSA_CARD_NAME=Generic
AUDIO_NETWORK_INTERFACE=enp34s0

# ------------------------------------------------------------------------------
# AI & Knowledge Suite
# ------------------------------------------------------------------------------
# Open WebUI Secret Key (generate with: `openssl rand -hex 32`)
WEBUI_SECRET_KEY=generate_a_random_32_byte_secret_key_here

# CouchDB credentials for Obsidian LiveSync
COUCHDB_USER=obsidian_admin
COUCHDB_PASSWORD=your_secure_couchdb_password_here

# ------------------------------------------------------------------------------
# Utilities & Dashboards
# ------------------------------------------------------------------------------
# Homarr Secret Encryption Key (generate with: `openssl rand -hex 32`)
HOMARR_SECRET_KEY=generate_a_random_32_byte_secret_key_here

# Speedtest Tracker App Key (generate with: `php artisan key:generate --show` or base64 32 bytes)
SPEEDTEST_APP_KEY=base64:your_32_byte_base64_encoded_key_here=

# Minecraft Playit.gg agent tunnel secret key
PLAYIT_SECRET_KEY=your_playit_agent_secret_key_here
