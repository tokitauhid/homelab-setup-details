# User permissions & Timezone
PUID=1000
PGID=1000
TZ=Asia/Dhaka

# Port mapping (shifted to 8085 to prevent clash)
NEXTEXPLORER_PORT=8085

# Directories to browse
NEXTEXPLORER_BROWSE_ROOT=/home/user
NEXTEXPLORER_CONFIG_DIR=./config
NEXTEXPLORER_CACHE_DIR=./cache

# Network
NEXTEXPLORER_NETWORK_NAME=nextexplorer_network
