# User permissions (TrueNAS apps user 568:568) & Timezone
VAULTWARDEN_UID=568
VAULTWARDEN_GID=568
TZ=Asia/Dhaka

# Port & Registration Lockdown
VAULTWARDEN_PORT=8222
VAULTWARDEN_SIGNUPS_ALLOWED=false

# Persistent Data Path (contains db.sqlite3, rsa_key.pem, ssl/, attachments/, sends/)
VAULTWARDEN_DATA_DIR=/mnt/main_pool/Docker_Configs/vaultwarden

# Network
VAULTWARDEN_NETWORK_NAME=vaultwarden_network
