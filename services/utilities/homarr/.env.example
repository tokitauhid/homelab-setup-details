# Timezone
TZ=Asia/Dhaka

# Port mapping
HOMARR_PORT=7575

# Secret key for encrypting stored credentials & integrations (Generate with `openssl rand -hex 32`)
HOMARR_SECRET_KEY=change_this_to_a_random_32_byte_hex_key

# Storage locations
HOMARR_CONFIG_DIR=./configs
HOMARR_ICONS_DIR=./icons
HOMARR_DATA_DIR=./data

# Network
HOMARR_NETWORK_NAME=homarr_network
