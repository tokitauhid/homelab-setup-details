# User permissions & Timezone (3000:3000 matches personal host user on TrueNAS)
VSCODE_PUID=3000
VSCODE_PGID=3000
TZ=Asia/Dhaka

# Web UI & container sudo credentials (replace before deploying)
VSCODE_USER=user
VSCODE_PASSWORD=your_secure_vscode_password_here
VSCODE_SUDO_PASSWORD=your_secure_sudo_password_here

# Port mappings (3020/3021 avoid clashes with Homepage, Firefox, and QDirStat)
VSCODE_HTTP_PORT=3020
VSCODE_HTTPS_PORT=3021

# Shared memory size (required for Electron/VS Code & Selkies rendering)
VSCODE_SHM_SIZE=1gb

# Storage
VSCODE_CONFIG_DIR=/mnt/main_pool/Docker_Configs/vscode
VSCODE_WORKSPACE_DIR=/mnt/main_pool/user

# Network
VSCODE_NETWORK_NAME=vscode_network
