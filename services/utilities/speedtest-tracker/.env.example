# User permissions & Timezone
PUID=1000
PGID=1000
TZ=Asia/Dhaka

# Port mappings (shifted to 8084 and 8444)
SPEEDTEST_HTTP_PORT=8084
SPEEDTEST_HTTPS_PORT=8444

# Speedtest cron schedule (default: every hour on the hour)
SPEEDTEST_SCHEDULE=0 * * * *

# App key & URL (Generate base64 32 byte key)
SPEEDTEST_APP_KEY=base64:generate_your_own_32_byte_base64_key_here=
SPEEDTEST_APP_URL=http://192.168.1.100:8084

# Storage
SPEEDTEST_CONFIG_DIR=./config

# Network
SPEEDTEST_NETWORK_NAME=speedtest_network
