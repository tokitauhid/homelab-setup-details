# User permissions & Timezone
PUID=1000
PGID=1000
TZ=Asia/Dhaka

# Port mappings (shifted to 3002 to avoid clash with Homepage & Open WebUI)
FIREFOX_HTTP_PORT=3002
FIREFOX_HTTPS_PORT=3003

# Shared memory size (prevents tab crashes on heavy web pages)
FIREFOX_SHM_SIZE=1gb

# Storage
FIREFOX_CONFIG_DIR=./config

# Network
FIREFOX_NETWORK_NAME=firefox_network
