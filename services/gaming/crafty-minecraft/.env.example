# Timezone
TZ=Asia/Dhaka

# Port mappings
CRAFTY_HTTPS_PORT=8443
CRAFTY_MC_PORT=25565
CRAFTY_BEDROCK_PORT=19132

# Storage directories
CRAFTY_CONFIG_DIR=./config
CRAFTY_SERVERS_DIR=./servers
CRAFTY_BACKUPS_DIR=./backups
CRAFTY_LOGS_DIR=./logs
CRAFTY_IMPORT_DIR=./import

# Playit.gg Secret Key (Obtain from https://playit.gg)
PLAYIT_SECRET_KEY=your_playit_secret_key_here

# Network
MINECRAFT_NETWORK_NAME=minecraft_network
