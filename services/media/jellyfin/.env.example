# User & Permissions
PUID=1000
PGID=1000
TZ=Asia/Dhaka

# Port mappings
JELLYFIN_PORT=8096
JELLYFIN_HTTPS_PORT=8920

# Storage mount paths
JELLYFIN_CONFIG_DIR=./config
MOVIES_DIR=/data/movies
TV_DIR=/data/tvshows
MUSIC_DIR=/data/music

# Optional Published Server URL
JELLYFIN_PUBLISHED_URL=http://192.168.0.225:8096

# Network
JELLYFIN_NETWORK_NAME=jellyfin_network
