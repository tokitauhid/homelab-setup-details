use_default_settings: true
general:
  debug: false
  instance_name: "Homelab SearXNG"

server:
  port: 8080
  bind_address: "0.0.0.0"
  secret_key: "ultrasecretkey"
  limiter: false
  image_proxy: true

search:
  safe_search: 0
  autocomplete: "google"
  default_lang: "en"

redis:
  url: redis://redis:6379/0
