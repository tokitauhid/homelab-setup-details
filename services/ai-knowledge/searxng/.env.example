# SearXNG Web Port
SEARXNG_PORT=8081

# Base URL (Adjust to your LAN IP or local domain name)
SEARXNG_BASE_URL=http://192.168.0.225:8081/

# Random secret key for session cookies (Generate with `openssl rand -hex 32`)
SEARXNG_SECRET_KEY=change_this_to_a_random_32_byte_hex_key

# Config and Redis storage
SEARXNG_CONFIG_DIR=./etc-searxng
SEARXNG_REDIS_DIR=./redis-data

# Network
SEARXNG_NETWORK_NAME=searxng_network
