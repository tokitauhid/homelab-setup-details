# Port mappings (Open WebUI shifted to 3001 to prevent conflict with Homepage on 3000)
OLLAMA_PORT=11434
WEBUI_PORT=3001

# Storage locations
OLLAMA_DATA_DIR=./ollama-data
WEBUI_DATA_DIR=./webui-data

# WebUI Session Secret (Generate with `openssl rand -hex 32`)
WEBUI_SECRET_KEY=change_this_to_a_random_32_byte_secret_key

# Ollama Tuning
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=1

# Network
AI_NETWORK_NAME=ai_network
