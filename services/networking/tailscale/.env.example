# Tailscale Auth Key (Generate an ephemeral or reusable key from Tailscale Admin Console)
TAILSCALE_AUTHKEY=tskey-auth-your_key_here

# Extra arguments (advertise subnet route for LAN access and enable exit node)
TAILSCALE_EXTRA_ARGS=--advertise-exit-node --advertise-routes=192.168.0.0/24

# State directory on host
TAILSCALE_DATA_DIR=./state
