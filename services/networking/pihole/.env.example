# Timezone
TZ=Asia/Dhaka

# Web UI Port (shifted to 8053 to prevent clash with port 80)
PIHOLE_WEB_PORT=8053
PIHOLE_SSL_PORT=4443

# Admin Web Password (set a strong password or leave blank for initial setup)
PIHOLE_PASSWORD=your_secure_password_here

# Persistent storage directories
PIHOLE_CONFIG_DIR=./etc-pihole
DNSMASQ_CONFIG_DIR=./etc-dnsmasq.d

# Network
PIHOLE_NETWORK_NAME=pihole_network
